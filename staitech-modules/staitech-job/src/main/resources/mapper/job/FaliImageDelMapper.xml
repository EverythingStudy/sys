<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.job.mapper.FailImageDelMapper">

    <resultMap type="cn.staitech.job.domain.SysImage" id="ImageResult">
        <result property="imageId" column="image_id"/>
        <result property="imageName" column="image_name"/>
        <result property="imageUrl" column="image_url"/>
        <result property="imagePath" column="image_path"/>
        <result property="thumbUrl" column="thumb_url"/>
        <result property="macroUrl" column="macro_url"/>
        <result property="labelUrl" column="label_url"/>
        <result property="processFlag" column="process_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectImageList" parameterType="cn.staitech.job.domain.SysImage" resultMap="ImageResult">
        SELECT image_id,
               image_name,
               image_url,
               image_path,
               thumb_url,
               macro_url,
               label_url,
               process_flag,
               create_by,
               create_time,
               update_by,
               update_time
        FROM
            tb_image
        where process_flag &lt;= -1
        order by image_id desc
    </select>


    <delete id="deleteImageByIdList" parameterType="java.util.List">
        delete
        from tb_image
        where image_id in
        <if test="imageIdList.size() != 0 and imageIdList != '' ">
            <foreach collection="imageIdList" item="imageId" open="(" separator="," close=")">
                #{imageId}
            </foreach>
        </if>
    </delete>



</mapper>