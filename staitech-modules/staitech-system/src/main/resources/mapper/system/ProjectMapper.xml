<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.system.mapper.ProjectMapper">
    <resultMap id="ProjectResult" type="cn.staitech.system.domain.vo.project.ProjectDetailsOut">
        <result property="projectId" column="project_id"/>
        <result property="projectName" column="project_name"/><!--项目名称-->
        <result property="imageTotal" column="image_total"/>
        <result property="createBy" column="create_by"/>
        <result property="description" column="description"/><!-- 描述 -->
        <result property="indicatorId" column="indicator_id"/><!--关联结构指标-->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="status" column="status"/>
        <result property="colorType" column="color_type"/><!-- 染色类型 -->
        <result property="speciesId" column="species_id"/><!-- 种属 -->
        <result property="speciesName" column="species_name"/>
        <result property="speciesNameEn" column="species_name_en"/>
        <result property="projectType" column="project_type"/><!-- 项目类型 -->
        <result property="organizationId" column="organization_id"/><!-- 机构 -->
        <result property="indicatorName" column="indicator_name"/>
        <result property="indicatorNameEn" column="indicator_name_en"/>
        <result property="productSeries" column="product_series"/>
        <result property="productSeriesId" column="product_series_id"/><!-- 品系 -->
        <result property="productSeriesEn" column="product_series_en"/>
        <result property="modelId" column="model_id"/>
        <result property="tissueId" column="tissue_id"/>
        <result property="contentId" column="content_id"/>
        <result property="systemCode" column="system_code"/>
        <result property="viscusCode" column="viscus_code"/>
        <result property="tagId" column="tag_id"/>
        <result property="slideTotal" column="slide_total"/>
        <result property="ifCreateQuestions" column="if_create_questions"/>
    </resultMap>


    <!--查询项目信息-->
    <select id="projectDetails" parameterType="cn.staitech.system.domain.vo.project.ProjectDetailsOut" resultMap="ProjectResult">
        select p.*, pi.indicator_name,pi.indicator_name_en, s.name as species_name, s.name_en as species_name_en ,ps.name as product_series,ps.name_en as product_series_en
        from tb_project as p
                 left join tb_pathological_indicator as pi on pi.indicator_id = p.indicator_id
                 left join tb_species as s on s.species_id=p.species_id
                 left join tb_product_series as ps on ps.product_series_id=p.product_series_id
                where p.project_id=#{projectId} and s.organization_id=#{organizationId} limit 1
    </select>



</mapper>